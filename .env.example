# Core standalone settings. Home Assistant is NOT required.
SDG_DATABASE_PATH=./data/school_day_grid.sqlite3
SDG_HOST=0.0.0.0
SDG_PORT=8088

# Optional local authentication. Set REQUIRE_LOGIN=true before exposing beyond a trusted LAN.
SDG_REQUIRE_LOGIN=false
SDG_SESSION_SECRET=

# External ICS URL subscriptions refresh every 6 hours by default.
SDG_SOURCE_REFRESH_SECONDS=21600

# Optional Home Assistant direct adapter. Leave blank for a pure standalone install.
SDG_HA_URL=
SDG_HA_TOKEN=
SDG_VERIFY_SSL=true

# Optional MQTT / Home Assistant Discovery integration.
SDG_MQTT_HOST=
SDG_MQTT_PORT=1883
SDG_MQTT_USERNAME=
SDG_MQTT_PASSWORD=
SDG_MQTT_DISCOVERY_PREFIX=homeassistant
SDG_MQTT_BASE_TOPIC=school_day_grid
